{
  "abstract": [
    {
      "text": "Light scenes realistically by precomputing illumination so surfaces pick up bounced color and ambient detail without recalculating it every frame.",
      "type": "text"
    }
  ],
  "hierarchy": {
    "paths": [
      [
        "doc://com.apple.documentation/documentation/technologies",
