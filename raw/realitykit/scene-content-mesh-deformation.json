{
  "abstract": [
    {
      "text": "Reshape and animate the geometry of 3D models at runtime, applying skinning, blend shapes, and subdivision so surfaces bend, flex, and deform as a scene plays.",
      "type": "text"
    }
  ],
  "hierarchy": {
    "paths": [
