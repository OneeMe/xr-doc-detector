{
  "abstract": [
    {
      "text": "Display app intents and app entities visually using snippets, and associate intents and",
      "type": "text"
    },
    {
      "text": " ",
      "type": "text"
    },
    {
      "text": "entities with your app’s scenes and views.",
      "type": "text"
    }
  ],
