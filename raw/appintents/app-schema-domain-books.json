{
  "abstract": [
    {
      "text": "Make your ebook reader’s actions available in the Shortcuts app by adopting schemas for common reading actions.",
      "type": "text"
    }
  ],
  "hierarchy": {
    "paths": [
      [
        "doc://com.apple.documentation/documentation/technologies",
